rules_version = '2';

// Reglas de Firestore - Aplicativo de Ventas (multitenant).
// Ver specs 001 (autenticacion y roles) y 002 (empresas).
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    // Perfil del usuario que hace la peticion.
    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function roles() {
      return autenticado() && perfil().roles is list ? perfil().roles : [];
    }

    function esSuperAdmin() {
      return autenticado() && roles().hasAny(['superadmin']);
    }

    function esDeEmpresa(empresaId) {
      return autenticado()
        && empresaId != null
        && perfil().empresaId == empresaId;
    }

    // Gestiona (Administrador) o audita (Developer) una empresa.
    function gestionaEmpresa(empresaId) {
      return esDeEmpresa(empresaId) && roles().hasAny(['administrador', 'developer']);
    }

    // Puede gestionar el catálogo (Administrador o Marketing) de una empresa.
    // Ver spec 003: el catálogo lo editan Administrador y Marketing.
    function puedeGestionarCatalogo(empresaId) {
      return esDeEmpresa(empresaId)
        && roles().hasAny(['administrador', 'marketing']);
    }

    // Personal interno que puede ver clientes (spec 004).
    function esInternoClientes() {
      return roles().hasAny(['administrador', 'gerente', 'vendedor', 'cajero']);
    }

    // Personal interno que trabaja con ventas (spec 005).
    function esInternoVentas() {
      return roles().hasAny(['administrador', 'gerente', 'vendedor', 'cajero']);
    }

    // Permite solo modificar los campos indicados (update parcial controlado).
    function soloCambiaCampos(permitidos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(permitidos);
    }

    // Perfil de usuario.
    match /usuarios/{uid} {
      // Cada quien lee su perfil; el Super Admin y los administradores de la
      // empresa pueden leer los usuarios de SU empresa (CA-05, CA-08).
      allow read: if autenticado() && (
        request.auth.uid == uid
        || esSuperAdmin()
        || (esDeEmpresa(resource.data.empresaId)
            && roles().hasAny(['administrador']))
      );

      // Al registrarse, el usuario crea SU documento y no puede suplantar a
      // otro. El Super Admin puede crear el perfil de un administrador de
      // empresa (spec 002, RF-03). El Administrador puede crear usuarios en SU
      // empresa (spec 001, RF-03 / CA-06), pero nunca con el rol Super Admin.
      allow create: if autenticado() && (
        (request.auth.uid == uid && request.resource.data.uid == uid)
        || (esSuperAdmin()
            && request.resource.data.uid == uid
            && request.resource.data.roles is list
            && request.resource.data.empresaId is string
            && request.resource.data.activo is bool)
        || (esDeEmpresa(request.resource.data.empresaId)
            && roles().hasAny(['administrador'])
            && request.resource.data.uid == uid
            && request.resource.data.roles is list
            && !request.resource.data.roles.hasAny(['superadmin'])
            && request.resource.data.activo is bool)
      );

      allow update: if
        // 1) El propio usuario edita sus datos, pero NO sus privilegios.
        (autenticado()
          && request.auth.uid == uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.roles == resource.data.roles
          && request.resource.data.empresaId == resource.data.empresaId
          && request.resource.data.activo == resource.data.activo)
        // 2) El Super Admin, o el Administrador con los usuarios de su propia
        //    empresa (no puede moverlos a otra empresa).
        || (esSuperAdmin())
        || (esDeEmpresa(resource.data.empresaId)
            && roles().hasAny(['administrador'])
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.empresaId == resource.data.empresaId);

      allow delete: if false;
    }

    // Empresas (tenants). Ver spec 002.
    // - Lectura: el Super Admin (todas) o cualquier usuario de la empresa.
    // - Alta/baja: solo el Super Admin (la baja es logica: estado=eliminada).
    // - Edicion: el Super Admin, o el Administrador de la empresa pero solo
    //   sobre logo, parametros y correo de notificacion (RF-06, RF-04).
    match /empresas/{empresaId} {
      allow read: if autenticado() && (esSuperAdmin() || esDeEmpresa(empresaId));

      allow create, delete: if esSuperAdmin();

      allow update: if esSuperAdmin()
        || (esDeEmpresa(empresaId)
            && roles().hasAny(['administrador'])
            && soloCambiaCampos(['logo', 'logoAncho', 'logoAlto', 'parametros', 'correoNotificacion']));
    }

    // Planes comerciales y sus limites (RF-11).
    match /planes/{planId} {
      allow read: if autenticado();
      allow write: if esSuperAdmin();
    }

    // Notificaciones in-app de licencia (RF-13).
    match /notificaciones/{notificacionId} {
      allow read: if esSuperAdmin() || esDeEmpresa(resource.data.empresaId);
      allow create: if esSuperAdmin();
      allow update: if esDeEmpresa(resource.data.empresaId)
        && soloCambiaCampos(['leida']);
      allow delete: if false;
    }

    // Auditoria: solo se puede AGREGAR (nunca editar ni borrar). Ver spec 001,
    // RF-11. La lectura queda para el Super Admin y para quien gestiona la
    // empresa (Administrador / Developer) de la misma empresa.
    match /_auditoria/{registroId} {
      allow create: if autenticado()
        && request.resource.data.usuario == request.auth.uid
        && request.resource.data.empresaId is string
        && request.resource.data.tabla is string
        && request.resource.data.documentoId is string
        && request.resource.data.operacion in ['INSERT', 'UPDATE', 'DELETE']
        && request.resource.data.fecha == request.time;

      allow read: if esSuperAdmin() || gestionaEmpresa(resource.data.empresaId);

      allow update, delete: if false;
    }

    // Catálogo de productos (spec 003).
    // - Lectura: el Super Admin o cualquier usuario de la empresa (incluye
    //   clientes e invitados registrados).
    // - Escritura: el Administrador o Marketing de la empresa.
    match /productos/{productoId} {
      allow read: if autenticado()
        && (esSuperAdmin() || esDeEmpresa(resource.data.empresaId));
      allow create: if puedeGestionarCatalogo(request.resource.data.empresaId);
      allow update, delete: if puedeGestionarCatalogo(resource.data.empresaId);
    }

    // Categorías del catálogo (spec 003, RF-10).
    match /categorias/{categoriaId} {
      allow read: if autenticado()
        && (esSuperAdmin() || esDeEmpresa(resource.data.empresaId));
      allow create: if puedeGestionarCatalogo(request.resource.data.empresaId);
      allow update, delete: if puedeGestionarCatalogo(resource.data.empresaId);
    }

    // Clientes (spec 004).
    // - Lee: el Super Admin, el personal interno de la empresa (Administrador,
    //   Gerente, Vendedor, Cajero) o el propio cliente (uid vinculado).
    // - Escribe: el Administrador o Vendedor de la empresa; el cliente puede
    //   editar su documento, pero no su empresaId, uid ni estado.
    match /clientes/{clienteId} {
      allow read: if autenticado() && (
        esSuperAdmin()
        || (esDeEmpresa(resource.data.empresaId) && esInternoClientes())
        || resource.data.uid == request.auth.uid
      );
      allow create: if autenticado()
        && esDeEmpresa(request.resource.data.empresaId)
        && roles().hasAny(['administrador', 'vendedor']);
      allow update: if autenticado() && (
        (esDeEmpresa(resource.data.empresaId)
          && roles().hasAny(['administrador', 'vendedor']))
        || (resource.data.uid == request.auth.uid
            && request.resource.data.empresaId == resource.data.empresaId
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.estado == resource.data.estado)
      );
      allow delete: if false;
    }

    // Ventas (spec 005).
    // - Lee: el Super Admin, el personal interno de la empresa o el propio
    //   cliente (clienteUid).
    // - Crea: Administrador o Vendedor. Actualiza (anula): Administrador.
    match /ventas/{ventaId} {
      allow read: if autenticado() && (
        esSuperAdmin()
        || (esDeEmpresa(resource.data.empresaId) && esInternoVentas())
        || resource.data.clienteUid == request.auth.uid
      );
      allow create: if autenticado()
        && esDeEmpresa(request.resource.data.empresaId)
        && roles().hasAny(['administrador', 'vendedor']);
      allow update: if autenticado()
        && esDeEmpresa(resource.data.empresaId)
        && roles().hasAny(['administrador']);
      allow delete: if false;
    }

    // Consecutivos de factura por empresa (spec 005, RN-04).
    match /consecutivos/{empresaId} {
      allow read, write: if autenticado()
        && esDeEmpresa(empresaId)
        && roles().hasAny(['administrador', 'vendedor']);
    }

    // Créditos y cobros (spec 006).
    match /creditos/{creditoId} {
      allow read: if autenticado() && (
        esSuperAdmin()
        || (esDeEmpresa(resource.data.empresaId) && esInternoVentas())
        || resource.data.clienteUid == request.auth.uid
      );
      allow create: if autenticado()
        && esDeEmpresa(request.resource.data.empresaId)
        && roles().hasAny(['administrador', 'vendedor', 'cajero']);
      allow update: if autenticado()
        && esDeEmpresa(resource.data.empresaId)
        && roles().hasAny(['administrador', 'cajero', 'gerente']);
      allow delete: if false;

      // Cuotas (subcolección). La empresa se obtiene del crédito padre.
      match /cuotas/{cuotaId} {
        allow read: if autenticado() && (
          esSuperAdmin()
          || esDeEmpresa(get(/databases/$(database)/documents/creditos/$(creditoId)).data.empresaId)
        );
        allow write: if autenticado()
          && esDeEmpresa(get(/databases/$(database)/documents/creditos/$(creditoId)).data.empresaId)
          && roles().hasAny(['administrador', 'vendedor', 'cajero']);
      }
    }

    // Pagos de crédito (spec 006). Solo inserción.
    match /pagos_credito/{pagoId} {
      allow read: if autenticado()
        && (esSuperAdmin() || esDeEmpresa(resource.data.empresaId));
      allow create: if autenticado()
        && esDeEmpresa(request.resource.data.empresaId)
        && roles().hasAny(['administrador', 'vendedor', 'cajero']);
      allow update, delete: if false;
    }

    // Proveedores (spec 007).
    match /proveedores/{proveedorId} {
      allow read: if autenticado()
        && (esSuperAdmin() || esDeEmpresa(resource.data.empresaId));
      allow create, update: if autenticado()
        && esDeEmpresa(request.resource.data.empresaId)
        && roles().hasAny(['administrador']);
      allow delete: if false;
    }

    // Compras (spec 007).
    match /compras/{compraId} {
      allow read: if autenticado()
        && (esSuperAdmin() || esDeEmpresa(resource.data.empresaId));
      allow create, update: if autenticado()
        && esDeEmpresa(request.resource.data.empresaId)
        && roles().hasAny(['administrador']);
      allow delete: if false;

      // Anexos legales (subcolección). La empresa se toma de la compra padre.
      match /anexos/{anexoId} {
        allow read: if autenticado() && (
          esSuperAdmin()
          || esDeEmpresa(get(/databases/$(database)/documents/compras/$(compraId)).data.empresaId)
        );
        allow create: if autenticado()
          && esDeEmpresa(request.resource.data.empresaId)
          && roles().hasAny(['administrador']);
        allow delete: if esSuperAdmin();
      }
    }

    // Cuentas por pagar a proveedores (spec 007).
    match /cuentas_por_pagar/{cuentaId} {
      allow read: if autenticado()
        && (esSuperAdmin() || esDeEmpresa(resource.data.empresaId));
      allow create, update: if autenticado()
        && esDeEmpresa(request.resource.data.empresaId)
        && roles().hasAny(['administrador', 'cajero']);
      allow delete: if false;
    }

    // Todo lo demas queda denegado por defecto (incluye `mail`: solo lo escribe
    // la Cloud Function con privilegios de administrador).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
