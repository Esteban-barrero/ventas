{
  "firestore": {
    "rules": "app/firestore.rules",
    "indexes": "app/firestore.indexes.json"
  },
  "storage": {
    "rules": "app/storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
